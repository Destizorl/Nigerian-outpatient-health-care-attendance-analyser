rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'facilityAffiliation', 'createdAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 150
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('role' in data) || (data.role is string && data.role.size() <= 100))
        && (!('facilityAffiliation' in data) || (data.facilityAffiliation is string && data.facilityAffiliation.size() <= 100))
        && data.createdAt is string;
    }

    function isValidNote(data) {
      return data.keys().hasAll(['noteId', 'userId', 'scenarioId', 'content', 'updatedAt'])
        && data.keys().hasOnly(['noteId', 'userId', 'scenarioId', 'scenarioTitle', 'content', 'updatedAt'])
        && data.noteId is string && data.noteId.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.scenarioId is string && data.scenarioId.size() <= 100
        && (!('scenarioTitle' in data) || (data.scenarioTitle is string && data.scenarioTitle.size() <= 200))
        && data.content is string && data.content.size() <= 5000
        && data.updatedAt is string;
    }

    // User Profiles Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Strict PII protection against enumeration
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if false;
    }

    // User Analytical Notes Collection
    match /user_notes/{noteId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(noteId) && isValidNote(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && isValidNote(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

  }
}
